#!/bin/sh
# NetworkManager pre-down hook: detach openconnect instead of letting the
# plugin log the session off.
#
# NetworkManager-openconnect stops openconnect with SIGINT, on which openconnect
# posts the protocol's logout first. The gateway then kills the session, the
# cookie wayle cached for it dies with it, and every reconnect — above all the
# one after a suspend — costs a fresh second factor. SIGHUP is openconnect's
# disconnect-without-logout: the tunnel goes down, the session stays valid until
# the gateway's own idle timeout, and wayle's cached cookie brings it back.
#
# vpn-pre-down is dispatched, and waited for, before NetworkManager asks the
# plugin to disconnect, so by the time the plugin's SIGINT lands there is
# nothing left to log out. This needs root, which is why it is a dispatcher
# hook rather than something wayle can do itself: openconnect runs as the
# plugin's user, and the plugin has no option for how it stops it.
#
# A suspend never dispatches vpn-pre-down. NetworkManager takes the devices
# down, and a tunnel whose device is gone is disconnected outright, skipping
# the deactivating state the dispatch hangs off — so the plugin's SIGINT was
# the first thing openconnect heard, and every suspend logged the session off.
# What a suspend does dispatch, and wait for, is the devices' own pre-down,
# with NetworkManager already asleep: that is the cue to detach every tunnel
# NetworkManager runs, since all of them are about to go.
#
# NetworkManager stopping — a package upgrade restarting it, a shutdown — is
# the same story without even a device pre-down: it stops the plugins, and
# openconnect logs off. So this also runs as NetworkManager.service's
# ExecStop=, which systemd runs before signalling NetworkManager, with the
# action nm-stop: every tunnel goes, and is detached first.
#
# $1 is the interface — the VPN's IP interface for vpn-pre-down, a device for
# pre-down, unused for nm-stop — and $2 the action.

# Each tunnel the plugin brought up is a tun device NetworkManager lists.
nm_tuns() {
  timeout 5 nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "tun" { print $1 }'
}

case $2 in
vpn-pre-down)
  ifaces=$1
  ;;
pre-down)
  # A device taken down while NetworkManager is awake is left alone: nothing
  # here says which tunnel, if any, rides it, and detaching one that rides
  # another device would take down a tunnel nothing else was touching.
  [ "$(timeout 5 nmcli -t -f STATE general 2>/dev/null)" = asleep ] || exit 0
  ifaces=$(nm_tuns)
  ;;
nm-stop)
  ifaces=$(nm_tuns)
  ;;
*)
  exit 0
  ;;
esac
[ -n "$ifaces" ] || exit 0

for pid in $(pgrep -x openconnect); do
  # The plugin names the tunnel interface with --interface; matching on it
  # is what keeps a second, unrelated openconnect out of this.
  tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null |
    awk -v ifaces="$ifaces" '
      BEGIN { n = split(ifaces, list); for (i = 1; i <= n; i++) wanted[list[i]] = 1 }
      prev == "--interface" && ($0 in wanted) { found = 1 }
      { prev = $0 }
      END { exit !found }' ||
    continue
  kill -HUP "$pid" 2>/dev/null || continue
  # NetworkManager holds the disconnect until this returns: wait for the
  # detach to finish rather than race the plugin's SIGINT, but not forever.
  for _ in $(seq 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
done
exit 0
